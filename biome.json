{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "files": {
    "includes": ["**/*.{js,jsx,ts,tsx,json,jsonc}", "!dist", "!artifacts", "!test-results"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "includes": ["**/*.{js,jsx,ts,tsx}"],
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error"
      }
    }
  }
}
